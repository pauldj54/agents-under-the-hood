AZURE_TENANT_ID=<your-tenant-id>
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL_DEPLOYMENT_NAME=MAI-Thinking-1
# Screen 4: optional Foundry runtime, independent of screen 3's deployment.
FOUNDRY_MEMORY_MODEL_DEPLOYMENT_NAME=gpt-chat-latest
OLLAMA_MODEL=phi3:3.8b
# Optional second local chat model on screens 3 and 4.
OLLAMA_CHAT_LLAMA_MODEL=llama3.2:1b
# Calculator and local tools require native tool support.
OLLAMA_TOOLS_MODEL=llama3.2:1b
# Screen 7: create a prompt-agent version with setup_foundry_tools.py first.
# Web Search needs an Azure OpenAI deployment, not the screen 3 MAI model.
# Set its existing deployment name here, then run setup_foundry_tools.py.
FOUNDRY_TOOLS_MODEL_DEPLOYMENT_NAME=
# FOUNDRY_TOOLS_AGENT_NAME=agents-under-the-hood-tools
# FOUNDRY_TOOLS_AGENT_VERSION=1
